# Stock Agents — konfiguracja
# Skopiuj do .env i uzupełnij

# Klucz API Anthropic — wymagany tylko dla trybu sentiment --mode claude
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Serwer HTTP
# API_HOST=0.0.0.0
# API_PORT=8000

# Cache pobrań rynkowych (ważne w chmurze — yfinance ma rate-limity)
# CACHE_TTL=900       # czas życia w sekundach (domyślnie 15 min)
# CACHE_ENABLED=1     # 0 wyłącza cache

# ── Broker Alpaca (stan konta + egzekucja zleceń) ──────────────────────────
# Klucze z https://app.alpaca.markets/  (zakładka Paper Trading → API Keys)
# DOMYŚLNIE tryb paper (konto DEMO, zero realnych pieniędzy).
ALPACA_API_KEY=
ALPACA_API_SECRET=
# 1 = paper/demo (domyślnie), 0 = real (UWAGA: prawdziwe pieniądze!)
# ALPACA_PAPER=1
