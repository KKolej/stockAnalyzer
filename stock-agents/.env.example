# Stock Agents — konfiguracja
# Skopiuj do .env i uzupełnij

# Klucz API Anthropic — wymagany tylko dla trybu sentiment --mode claude
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Serwer HTTP
# API_HOST=0.0.0.0
# API_PORT=8000

# Cache pobrań rynkowych (ważne w chmurze — yfinance ma rate-limity)
# CACHE_TTL=900       # czas życia w sekundach (domyślnie 15 min)
# CACHE_ENABLED=1     # 0 wyłącza cache

# ── Broker Alpaca (stan konta + egzekucja zleceń) ──────────────────────────
# Klucze z https://app.alpaca.markets/  (zakładka Paper Trading → API Keys)
# DOMYŚLNIE tryb paper (konto DEMO, zero realnych pieniędzy).
ALPACA_API_KEY=
ALPACA_API_SECRET=
# 1 = paper/demo (domyślnie), 0 = real (UWAGA: prawdziwe pieniądze!)
# ALPACA_PAPER=1

# ── n8n na publicznym VPS (produkcja) — patrz DEPLOYMENT.md ─────────────────
# API niepubliczne (tylko sieć compose); n8n za HTTPS z proxy Mikrusa.
# API_BIND=127.0.0.1
# N8N_PORT=20151                      # przydzielony port TCP z panelu Mikrusa
# N8N_USER_MANAGEMENT_DISABLED=false  # WYMAGANE na publicznym VPS — logowanie włączone
# N8N_SECURE_COOKIE=true              # true gdy wchodzisz po HTTPS (subdomena/proxy)
# N8N_WEBHOOK_URL=https://twoja-subdomena.example
# N8N_HOST=twoja-subdomena.example
# N8N_PROTOCOL=https
# N8N_PROXY_HOPS=1                    # n8n za jednym reverse-proxy (nagłówki X-Forwarded-*)
